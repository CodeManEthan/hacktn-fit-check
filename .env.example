# Copy to .env and fill in. Never commit .env.
# The OCI API signing key lives in ~/.oci/config - not here.

# api_key (default) reads ~/.oci/config; instance_principal signs as the VM.
OCI_AUTH=api_key
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-chicago-1

# Leave blank to fall back to the tenancy OCID from ~/.oci/config.
OCI_COMPARTMENT_ID=

REASONING_MODEL=openai.gpt-oss-120b
VISION_MODEL=meta.llama-4-maverick-17b-128e-instruct-fp8

# Local default is SQLite. On the OCI VM point this at MySQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/fitcheck
DATABASE_URL=

# Live FDA GUDID lookup for manufacturer support. on by default; off turns it off
# (every support row then reads needs-info unless the nonprofit recorded an answer).
GUDID_LOOKUP=on
